{
  "name": "refit",
  "version": "0.39.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "refit": "node bin/refit.mjs",
    "package:cli": "node scripts/package-cli.mjs",
    "api:scan": "tsx pipeline/cli.ts",
    "api:run": "tsx pipeline/workflow-cli.ts",
    "api:validate": "tsx pipeline/validation-cli.ts",
    "stripe:validate": "tsx pipeline/validation-cli.ts",
    "stripe:snapshot": "tsx pipeline/snapshot-cli.ts",
    "stripe:check": "tsx pipeline/check-cli.ts",
    "stripe:scan": "tsx pipeline/cli.ts",
    "stripe:replay": "tsx pipeline/cli.ts --repository pipeline/fixtures/repository --before pipeline/fixtures/before.json --after pipeline/fixtures/after.json",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc -b",
    "format": "prettier --write src pipeline bin scripts index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src pipeline bin scripts index.html vite.config.ts tsconfig.json package.json",
    "eval:ai": "tsx pipeline/ai-eval-cli.ts",
    "eval:ai-patch": "tsx pipeline/ai-patch-eval-cli.ts",
    "benchmark:coverage": "tsx pipeline/sdk-coverage-cli.ts",
    "benchmark:stripe": "tsx pipeline/stripe-benchmark-cli.ts",
    "benchmark:stripe-labels": "tsx pipeline/stripe-ground-truth-cli.ts",
    "benchmark:stripe-score": "tsx pipeline/stripe-benchmark-score.ts",
    "deadlines:check": "node bin/refit.mjs deadlines --check-registry",
    "model-parameters:check": "node bin/refit.mjs deadlines --check-parameters",
    "meta-graph:check": "node bin/refit.mjs meta-graph --check-changes",
    "benchmark:shopify": "tsx pipeline/shopify-benchmark-cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.11.2",
    "graphql": "16.14.2",
    "parse5": "^8.0.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-compiler": "npm:typescript@^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
