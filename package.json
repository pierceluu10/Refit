{
  "name": "refit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "refit": "node bin/refit.mjs",
    "package:cli": "node scripts/package-cli.mjs",
    "api:scan": "tsx pipeline/cli.ts",
    "api:run": "tsx pipeline/workflow-cli.ts",
    "api:validate": "tsx pipeline/validation-cli.ts",
    "stripe:validate": "tsx pipeline/validation-cli.ts",
    "stripe:snapshot": "tsx pipeline/snapshot-cli.ts",
    "stripe:check": "tsx pipeline/check-cli.ts",
    "stripe:scan": "tsx pipeline/cli.ts",
    "stripe:replay": "tsx pipeline/cli.ts --repository pipeline/fixtures/repository --before pipeline/fixtures/before.json --after pipeline/fixtures/after.json",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc -b",
    "format": "prettier --write src pipeline bin scripts index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src pipeline bin scripts index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-compiler": "npm:typescript@^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
