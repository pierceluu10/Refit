{
  "name": "refit",
  "version": "0.39.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc -b",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json app inventory harness memory providers evals shared orchestrator compliance",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json app inventory harness memory providers evals shared orchestrator compliance"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/doto": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "workspaces": [
    "app",
    "inventory",
    "harness",
    "memory",
    "providers",
    "evals",
    "shared",
    "orchestrator",
    "compliance"
  ]
}
