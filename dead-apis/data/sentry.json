  "entries": [
    {
      "id": "SN-1.sendDefaultPii",
      "provider": "sentry",
      "what": "The sendDefaultPii option is gone from the Sentry JavaScript SDK, replaced by dataCollection.",
      "diedOn": "2026-09-23",
      "source": {
        "url": "https://raw.githubusercontent.com/getsentry/sentry-javascript/HEAD/CHANGELOG.md",
        "checkedOn": "2026-11-05",
        "quote": "feat(core)!: Remove `sendDefaultPii` in favor of `dataCollection`"
      },
      "lookFor": [
        "sendDefaultPii set or read in code that runs the JavaScript SDK at 11.0.0 or later."
      ],
      "matchers": [
        {
          "kind": "field",
          "value": "sendDefaultPii",
          "on": ["Sentry.init"]
        },
        {
          "kind": "regex",
          "value": "\\bsendDefaultPii\\b",
          "ambiguous": true
        }
      ],
      "versions": "A break only at 11.0.0 or later of the JavaScript SDK (@sentry/node, @sentry/nextjs, @sentry/react and the rest of that repo). @sentry/react-native and @sentry/electron have version numbers of their own and are not gated here, and Python's send_default_pii is another SDK.",
      "appliesTo": {
        "describe": "A break only at 11.0.0 or later of the JavaScript SDK (@sentry/node, @sentry/nextjs, @sentry/react and the rest of that repo). @sentry/react-native and @sentry/electron have version numbers of their own and are not gated here, and Python's send_default_pii is another SDK.",
