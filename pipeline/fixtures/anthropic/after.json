{
  "openapi": "3.0.3",
  "info": { "title": "Anthropic messages fixture", "version": "2023-06-01" },
  "paths": {
    "/v1/messages": {
      "post": {
        "operationId": "messages.create",
        "summary": "Create a message",
        "description": "messages.create accepts max_tokens as the generation limit.",
        "responses": {
          "200": {
            "description": "Message",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Message" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Message": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }
        }
      }
    }
  }
}
