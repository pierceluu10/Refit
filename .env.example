# Copy to .env and fill in locally. Never commit the filled-in file.

# Model access. Without it, the CLI runs offline on fixture stubs.
ANTHROPIC_API_KEY=
# Required for any real model run, in US dollars. The run refuses to spend without it.
REFIT_AI_BUDGET_USD=

# GitHub App (app/config.ts).
GITHUB_APP_ID=
# Set one of these two: the PEM itself or a path to it.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
# Optional: server port (default 3000) and host (default 127.0.0.1).
PORT=
HOST=
# Optional: job queue file (default .refit/queue.json).
REFIT_QUEUE_FILE=

# Optional: token for higher GitHub release-API rate limits in watchers. Sent only to api.github.com.
GITHUB_TOKEN=

# Optional: sandbox mode, docker or local (auto-detected by default), and image override.
REFIT_SANDBOX=
REFIT_SANDBOX_IMAGE=

# Optional: Slack incoming webhook for opened PRs and close deadlines.
REFIT_SLACK_WEBHOOK_URL=
