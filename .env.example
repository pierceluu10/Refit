OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
REFIT_AI_BUDGET_USD=1
# Optional: persistent budget directory (defaults to ~/.refit/ai-budget).
REFIT_AI_BUDGET_DIRECTORY=

# GitHub App mode: add --github-app when publishing.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=

# Personal-token mode: omit --github-app when publishing.
GITHUB_TOKEN=

# Local service: two different random secrets, each 32–256 characters.
# GitHub's webhook Secret is REFIT_WEBHOOK_SECRET; never use the service token there.
REFIT_WEBHOOK_SECRET=
REFIT_SERVICE_TOKEN=

# Optional: shared cache for automatically prepared npm validation dependencies.
REFIT_DEPENDENCY_CACHE_DIRECTORY=
