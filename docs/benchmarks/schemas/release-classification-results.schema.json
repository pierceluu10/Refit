{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI release classification scored against the Stripe catalog",
  "description": "Written by `refit classify-release` (pipeline/release-classification-cli.ts): the model's category for each changelog page and its handling, pack family and identifiers for each change statement (the catalog's statements, or with `statements: none` its own, matched to the catalog's by shared content words), scored against docs/benchmarks/stripe-changelog/catalog. Prompts and raw model outputs are in the matching *-audit.json. See docs/RELEASE-CLASSIFICATION.md.",
  "type": "object",
  "required": [
    "formatVersion",
    "commit",
    "startedAt",
    "configuredModel",
    "reportedModels",
    "budgetUsd",
    "costUsd",
    "releases",
    "statements",
    "summary",
    "byRelease",
    "entries",
    "rows",
    "extras"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "commit": {
      "$ref": "common.schema.json#/$defs/commit"
    },
    "startedAt": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "configuredModel": {
      "type": "string",
      "minLength": 1
    },
    "reportedModels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budgetUsd": {
      "type": "number",
      "minimum": 0
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "statements": {
      "description": "catalog: the catalog's statements were sent. none: the page only; the model listed its own.",
      "enum": ["catalog", "none"]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "byRelease": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/summary"
      }
    },
    "entries": {
      "description": "One per changelog page; a page's handling is its weakest change's.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["release", "slug", "catalog", "predicted", "error"],
        "additionalProperties": false,
        "properties": {
          "release": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "catalog": {
            "type": "object",
            "required": ["category", "handling"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "$ref": "#/$defs/category"
              },
              "handling": {
                "$ref": "#/$defs/handling"
              }
            }
          },
          "predicted": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": ["category", "handling"],
                "additionalProperties": false,
                "properties": {
                  "category": {
                    "$ref": "#/$defs/category"
                  },
                  "handling": {
                    "$ref": "#/$defs/handling"
                  }
                }
              }
            ]
          },
          "error": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "rows": {
      "description": "One per change statement in the catalog entry's `changed`.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "release",
          "slug",
          "index",
          "statement",
          "catalog",
          "predicted",
          "handling",
          "handlingCorrect",
          "familyCorrect",
          "dangerous"
        ],
        "additionalProperties": false,
        "properties": {
          "release": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "index": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "statement": {
            "type": "string"
          },
          "catalog": {
            "type": "object",
            "required": ["handling", "family", "fullDiffOnly"],
            "additionalProperties": false,
            "properties": {
              "handling": {
                "$ref": "#/$defs/handling"
              },
              "family": {
                "$ref": "#/$defs/family"
              },
              "fullDiffOnly": {
                "type": "boolean"
              }
            }
          },
          "predicted": {
            "description": "The model's changes assigned to this statement: exactly one when the catalog's statements were sent.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["handling", "family", "identifiers", "rationale", "similarity"],
              "additionalProperties": false,
              "properties": {
                "statement": {
                  "description": "The model's own statement, with `statements: none`.",
                  "type": "string"
                },
                "handling": {
                  "$ref": "#/$defs/handling"
                },
                "family": {
                  "$ref": "#/$defs/family"
                },
                "identifiers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rationale": {
                  "type": "string"
                },
                "similarity": {
                  "description": "Dice coefficient of content words with the catalog statement; null when the statement was sent.",
                  "type": ["number", "null"]
                }
              }
            }
          },
          "handling": {
            "description": "The assigned changes' handling, mixed when they disagree, null when none was assigned.",
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/handling"
              },
              {
                "const": "mixed"
              }
            ]
          },
          "handlingCorrect": {
            "description": "At least one change was assigned, and every one has the catalog's handling.",
            "type": "boolean"
          },
          "familyCorrect": {
            "type": "boolean"
          },
          "dangerous": {
            "description": "An assigned change has rule or ai where the catalog says stop or none.",
            "type": "boolean"
          }
        }
      }
    },
    "extras": {
      "description": "Changes the model listed that share no content word with any catalog statement on the page.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "release",
          "slug",
          "statement",
          "handling",
          "family",
          "identifiers",
          "rationale",
          "automatic"
        ],
        "additionalProperties": false,
        "properties": {
          "release": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "statement": {
            "description": "The model's own statement, with `statements: none`.",
            "type": "string"
          },
          "handling": {
            "$ref": "#/$defs/handling"
          },
          "family": {
            "$ref": "#/$defs/family"
          },
          "identifiers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "automatic": {
            "description": "rule or ai, counted as dangerous.",
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "category": {
      "enum": ["api", "stripejs"]
    },
    "handling": {
      "enum": ["none", "stop", "ai", "generic", "rule"]
    },
    "family": {
      "enum": [
        "moved-value",
        "moved-id",
        "period-helper",
        "request-rename",
        "request-wrap",
        "read-review",
        "none"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "pages",
        "pagesClassified",
        "pageCategoryCorrect",
        "pageHandlingCorrect",
        "changes",
        "changesClassified",
        "handlingCorrect",
        "handlingConfusion",
        "familyImplied",
        "familyImpliedCorrect",
        "familySpurious",
        "modelStatements",
        "extraStatements",
        "dangerous",
        "extraAutomatic",
        "ruleNotInCatalog"
      ],
      "additionalProperties": false,
      "properties": {
        "pages": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "pagesClassified": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "pageCategoryCorrect": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "pageHandlingCorrect": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "changes": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "changesClassified": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "handlingCorrect": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "handlingConfusion": {
          "description": "Catalog handling, then the row's handling (mixed, or unclassified when none was assigned), to statement count.",
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/counts"
          }
        },
        "familyImplied": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "familyImpliedCorrect": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "familySpurious": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "modelStatements": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "extraStatements": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "dangerous": {
          "description": "Statements with a dangerous assigned change, plus extra changes with rule or ai.",
          "$ref": "common.schema.json#/$defs/count"
        },
        "extraAutomatic": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "ruleNotInCatalog": {
          "$ref": "common.schema.json#/$defs/count"
        }
      }
    }
  }
}
