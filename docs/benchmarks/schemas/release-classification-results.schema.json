{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI release classification scored against the Stripe catalog",
  "description": "Written by `refit classify-release` (pipeline/release-classification-cli.ts): the model's category for each changelog page and its handling, pack family and identifiers for each change statement, scored against docs/benchmarks/stripe-changelog/catalog. Prompts and raw model outputs are in the matching *-audit.json. See docs/RELEASE-CLASSIFICATION.md.",
  "type": "object",
  "required": [
    "formatVersion",
    "commit",
    "startedAt",
    "configuredModel",
    "reportedModels",
    "budgetUsd",
    "costUsd",
    "releases",
    "summary",
    "byRelease",
    "entries",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "commit": { "$ref": "common.schema.json#/$defs/commit" },
    "startedAt": { "$ref": "common.schema.json#/$defs/time" },
    "configuredModel": { "type": "string", "minLength": 1 },
    "reportedModels": { "type": "array", "items": { "type": "string" } },
    "budgetUsd": { "type": "number", "minimum": 0 },
    "costUsd": { "type": "number", "minimum": 0 },
    "releases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "summary": { "$ref": "#/$defs/summary" },
    "byRelease": { "type": "object", "additionalProperties": { "$ref": "#/$defs/summary" } },
    "entries": {
      "description": "One per changelog page; a page's handling is its weakest change's.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["release", "slug", "catalog", "predicted", "error"],
        "additionalProperties": false,
        "properties": {
          "release": { "type": "string" },
          "slug": { "type": "string" },
          "catalog": {
            "type": "object",
            "required": ["category", "handling"],
            "additionalProperties": false,
            "properties": {
              "category": { "$ref": "#/$defs/category" },
              "handling": { "$ref": "#/$defs/handling" }
            }
          },
          "predicted": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["category", "handling"],
                "additionalProperties": false,
                "properties": {
                  "category": { "$ref": "#/$defs/category" },
                  "handling": { "$ref": "#/$defs/handling" }
                }
              }
            ]
          },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "rows": {
      "description": "One per change statement in the catalog entry's `changed`.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "release",
          "slug",
          "index",
          "statement",
          "catalog",
          "predicted",
          "handlingCorrect",
          "familyCorrect",
          "dangerous"
        ],
        "additionalProperties": false,
        "properties": {
          "release": { "type": "string" },
          "slug": { "type": "string" },
          "index": { "$ref": "common.schema.json#/$defs/count" },
          "statement": { "type": "string" },
          "catalog": {
            "type": "object",
            "required": ["handling", "family", "fullDiffOnly"],
            "additionalProperties": false,
            "properties": {
              "handling": { "$ref": "#/$defs/handling" },
              "family": { "$ref": "#/$defs/family" },
              "fullDiffOnly": { "type": "boolean" }
            }
          },
          "predicted": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["handling", "family", "identifiers", "rationale"],
                "additionalProperties": false,
                "properties": {
                  "handling": { "$ref": "#/$defs/handling" },
                  "family": { "$ref": "#/$defs/family" },
                  "identifiers": { "type": "array", "items": { "type": "string" } },
                  "rationale": { "type": "string" }
                }
              }
            ]
          },
          "handlingCorrect": { "type": "boolean" },
          "familyCorrect": { "type": "boolean" },
          "dangerous": {
            "description": "Predicted rule or ai where the catalog says stop or none.",
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "category": { "enum": ["api", "stripejs"] },
    "handling": { "enum": ["none", "stop", "ai", "generic", "rule"] },
    "family": {
      "enum": [
        "moved-value",
        "moved-id",
        "period-helper",
        "request-rename",
        "request-wrap",
        "read-review",
        "none"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "pages",
        "pagesClassified",
        "pageCategoryCorrect",
        "pageHandlingCorrect",
        "changes",
        "changesClassified",
        "handlingCorrect",
        "handlingConfusion",
        "familyImplied",
        "familyImpliedCorrect",
        "familySpurious",
        "dangerous",
        "ruleNotInCatalog"
      ],
      "additionalProperties": false,
      "properties": {
        "pages": { "$ref": "common.schema.json#/$defs/count" },
        "pagesClassified": { "$ref": "common.schema.json#/$defs/count" },
        "pageCategoryCorrect": { "$ref": "common.schema.json#/$defs/count" },
        "pageHandlingCorrect": { "$ref": "common.schema.json#/$defs/count" },
        "changes": { "$ref": "common.schema.json#/$defs/count" },
        "changesClassified": { "$ref": "common.schema.json#/$defs/count" },
        "handlingCorrect": { "$ref": "common.schema.json#/$defs/count" },
        "handlingConfusion": {
          "description": "Catalog handling, then predicted handling (or unclassified), to change count.",
          "type": "object",
          "additionalProperties": { "$ref": "common.schema.json#/$defs/counts" }
        },
        "familyImplied": { "$ref": "common.schema.json#/$defs/count" },
        "familyImpliedCorrect": { "$ref": "common.schema.json#/$defs/count" },
        "familySpurious": { "$ref": "common.schema.json#/$defs/count" },
        "dangerous": { "$ref": "common.schema.json#/$defs/count" },
        "ruleNotInCatalog": { "$ref": "common.schema.json#/$defs/count" }
      }
    }
  }
}
