{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta Graph benchmark run results",
  "description": "results.json written by `npm run benchmark:meta`: one row per repository, in list order. Its harness.json follows harness.schema.json.",
  "type": "array",
  "items": {
    "type": "object",
    "$ref": "common.schema.json#/$defs/classified",
    "required": ["repo", "commit", "outcomeClass"],
    "properties": {
      "repo": { "$ref": "common.schema.json#/$defs/repo" },
      "stars": { "$ref": "common.schema.json#/$defs/count" },
      "commit": { "$ref": "common.schema.json#/$defs/commit" },
      "error": { "type": "string" },
      "outcome": { "enum": ["no-graph-usage", "current", "version-move", "needs-review"] },
      "result": {
        "enum": ["validated", "needs-review", "no-change", "infrastructure"],
        "x-added": "2026-10-31"
      },
      "liveRequests": { "$ref": "common.schema.json#/$defs/count" },
      "testRequests": { "$ref": "common.schema.json#/$defs/count" },
      "versions": { "type": "array", "items": { "type": "string" } },
      "businessSdk": { "type": ["string", "null"] },
      "target": { "type": "string", "pattern": "^v\\d+\\.\\d+$" },
      "moves": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["file", "line", "from", "to"],
          "properties": {
            "file": { "type": "string" },
            "line": { "type": "integer" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        }
      },
      "stops": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["requests", "reasons"],
          "properties": {
            "file": { "type": ["string", "null"] },
            "line": { "type": ["integer", "null"] },
            "from": { "type": ["string", "null"] },
            "requests": { "$ref": "common.schema.json#/$defs/count" },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "stopKinds": { "$ref": "common.schema.json#/$defs/counts" },
      "current": { "$ref": "common.schema.json#/$defs/count" },
      "patch": { "type": "boolean" },
      "workflow": {
        "type": "object",
        "required": ["status", "checks", "unresolved", "pullRequest"],
        "properties": {
          "status": { "type": "string", "minLength": 1 },
          "stage": { "type": "string" },
          "reason": { "type": "string" },
          "error": { "type": "string" },
          "checks": { "enum": ["tests", "typecheck", "none"] },
          "validation": { "type": "string" },
          "grade": { "enum": ["A", "B", "C", "D"] },
          "proven": { "type": "boolean" },
          "unresolved": { "$ref": "common.schema.json#/$defs/count" },
          "generator": { "type": "string" },
          "agent": {
            "type": "object",
            "required": ["outcome", "costUsd", "errors"],
            "properties": {
              "outcome": { "enum": ["passed", "unproven", "no-change", "failed"] },
              "costUsd": { "type": "number", "minimum": 0 },
              "errors": { "$ref": "common.schema.json#/$defs/count" }
            },
            "x-added": "2026-10-31"
          },
          "pullRequest": { "type": "boolean" }
        },
        "x-added": "2026-10-29"
      },
      "seconds": { "$ref": "common.schema.json#/$defs/count" },
      "outcomeClass": { "$ref": "common.schema.json#/$defs/outcomeClass" },
      "infrastructure": { "$ref": "common.schema.json#/$defs/infrastructure" }
    }
  }
}
