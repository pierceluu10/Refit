{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI patch guard replay",
  "description": "Written by `npx tsx pipeline/ai-patch-eval-replay.ts`: every guard of proposeAiPatch() run over each recorded patch, once on Refit's rule-patched code and once on the original code, with the commit whose guards ran. No model is called and no repository code runs.",
  "type": "object",
  "required": ["formatVersion", "source", "commit", "after", "rows"],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "after": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "validation", "verdict"],
        "properties": {
          "repo": {
            "type": "string"
          },
          "validation": {
            "type": ["string", "null"]
          },
          "verdict": {
            "type": ["string", "null"]
          },
          "error": {
            "type": "string"
          },
          "rulePatch": {
            "type": "string"
          },
          "fromFallback": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unscanned": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "againstRules": {
            "$ref": "#/$defs/guards"
          },
          "againstOriginal": {
            "$ref": "#/$defs/guards"
          }
        }
      }
    }
  },
  "$defs": {
    "guards": {
      "type": "object",
      "required": ["refusedBy", "files", "refusals"],
      "properties": {
        "refusedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refusals": {
          "type": "object",
          "required": [
            "changedEventTypes",
            "addedItemChoices",
            "droppedRequestPaths",
            "addedTypeEscapes",
            "newShapeOnlyReads",
            "substitutions"
          ],
          "additionalProperties": {
            "type": "array"
          }
        }
      }
    }
  }
}
