{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deadline benchmark reruns at two Refit commits",
  "description": "The frozen deadline list scanned by scripts/deadline-benchmark-setup.mjs from two pinned checkouts, keyed by run name. Each run's `refit` is a short commit typed in by hand, not a harness record.",
  "type": "object",
  "required": ["formatVersion", "run", "list", "command", "runs"],
  "properties": {
    "formatVersion": { "const": 1 },
    "run": { "$ref": "common.schema.json#/$defs/date" },
    "list": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "runs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["refit", "results"],
        "additionalProperties": false,
        "properties": {
          "refit": { "$ref": "common.schema.json#/$defs/shortCommit" },
          "results": {
            "type": "array",
            "items": { "$ref": "deadline-results.schema.json#/$defs/row" }
          }
        }
      }
    }
  }
}
