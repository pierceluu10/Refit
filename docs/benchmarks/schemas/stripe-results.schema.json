{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stripe benchmark run results",
  "description": "results.json written by `npm run benchmark:stripe`: one row per repository, in list order. Its harness.json follows harness.schema.json.",
  "type": "array",
  "items": {
    "type": "object",
    "$ref": "common.schema.json#/$defs/classified",
    "required": ["repo", "commit", "outcomeClass"],
    "properties": {
      "repo": {
        "$ref": "common.schema.json#/$defs/repo"
      },
      "stars": {
        "$ref": "common.schema.json#/$defs/count"
      },
      "commit": {
        "$ref": "common.schema.json#/$defs/commit"
      },
      "before": {
        "type": "string"
      },
      "beforeSource": {
        "type": "string"
      },
      "after": {
        "type": "string"
      },
      "packageManager": {
        "type": "string"
      },
      "read": {
        "description": "ok, or why Refit could not read the repository.",
        "type": "string"
      },
      "scanCrash": {
        "type": "string"
      },
      "sdkCalls": {
        "$ref": "common.schema.json#/$defs/count"
      },
      "tracedCalls": {
        "$ref": "common.schema.json#/$defs/count"
      },
      "calledMethods": {
        "$ref": "common.schema.json#/$defs/count"
      },
      "mappedMethods": {
        "$ref": "common.schema.json#/$defs/count"
      },
      "webhookHandlers": {
        "$ref": "common.schema.json#/$defs/count"
      },
      "shippedAdapter": {
        "$ref": "#/$defs/scan"
      },
      "fullAdapter": {
        "$ref": "#/$defs/scan"
      },
      "productionMode": {
        "$ref": "#/$defs/scan"
      },
      "customerMode": {
        "$ref": "#/$defs/scan",
        "x-added": "2026-10-24",
        "description": "The built-in adapter with the full contract diff on, as a hosted customer's worker scans; never validated."
      },
      "changelogNotes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "validatable": {
        "type": "boolean"
      },
      "checks": {
        "enum": ["none", "tests", "typecheck", "generated-only"]
      },
      "packageDirectory": {
        "type": "string",
        "minLength": 1,
        "x-added": "2026-10-25",
        "description": "The nested package whose own lockfile and checks validation uses (pipeline/preparation-packages.ts); absent when it uses the repository root."
      },
      "validationSeconds": {
        "$ref": "common.schema.json#/$defs/count"
      },
      "workflow": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "validation": {
            "type": "string"
          },
          "repairAttempts": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "pullRequest": {
            "type": "boolean"
          },
          "fullDiff": {
            "type": "boolean",
            "x-added": "2026-10-24",
            "description": "True when the workflow itself ran with the full contract diff, because production mode did not stop before validation."
          },
          "baselineReused": {
            "type": "boolean",
            "description": "Present and true when the baseline check result was not run here but reused from an identical earlier run (REFIT_BASELINE_CHECK_CACHE_DIRECTORY)."
          }
        }
      },
      "ai": {
        "type": "object",
        "required": ["outcome"],
        "properties": {
          "outcome": {
            "enum": ["proposed", "blocked", "declined", "rejected-by-guard", "error"]
          }
        }
      },
      "publication": {
        "type": "object"
      },
      "seconds": {
        "$ref": "common.schema.json#/$defs/count"
      },
      "outcomeClass": {
        "$ref": "common.schema.json#/$defs/outcomeClass",
        "x-added": "2026-10-22"
      },
      "infrastructure": {
        "$ref": "common.schema.json#/$defs/infrastructure"
      },
      "production": {
        "x-added": "2026-10-24",
        "description": "The production-mode outcome (full contract diff on): the scan stop before validation, or the workflow's own outcome when it ran with fullDiff. Only rows the workflow ran for.",
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "validation": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "scan": {
      "description": "A summarized pipeline report, or the error that stopped it.",
      "type": "object",
      "anyOf": [
        {
          "required": ["error"],
          "properties": {
            "error": {
              "type": "string"
            }
          }
        },
        {
          "required": ["status", "confirmed", "review", "findings"],
          "properties": {
            "status": {
              "type": "string"
            },
            "removedFields": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "confirmed": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "review": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "$ref": "common.schema.json#/$defs/location",
                "required": ["property", "confidence"],
                "properties": {
                  "property": {
                    "type": "string"
                  },
                  "confidence": {
                    "enum": ["confirmed", "review"]
                  },
                  "webhook": {
                    "type": "string",
                    "x-added": "2026-10-24",
                    "description": "Signed-webhook payload reads only: the migrating rule, or unmigrated. Runs before F5's first slice lack it."
                  }
                }
              },
              "x-added": "2026-10-14",
              "description": "Added with the Stripe ground truth (b36fbdc); runs before it lack it."
            },
            "confirmedFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reviewReasons": {
              "$ref": "common.schema.json#/$defs/counts"
            },
            "stop": {
              "type": ["string", "null"],
              "x-added": "2026-10-24",
              "description": "The workflow's stop before validation for this scan (null when it would continue)."
            },
            "impacts": {
              "x-added": "2026-10-24",
              "description": "Each operation impact: the called operation, its call sites and the oasdiff changes on it.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["operationId", "method", "path", "usages", "changes"],
                "properties": {
                  "operationId": {
                    "type": "string"
                  },
                  "method": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "usages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "text"],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "unmappedChanges": {
              "$ref": "common.schema.json#/$defs/count",
              "x-added": "2026-10-24"
            },
            "unmapped": {
              "x-added": "2026-10-24",
              "description": "The first 500 breaking oasdiff changes no rule or finding accounts for, on any adapter-selected operation.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "text"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "operation": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
