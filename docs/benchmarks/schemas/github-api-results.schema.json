{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub API review-only detection results",
  "description": "Written by scripts/github-benchmark.mjs: the GitHub REST and GraphQL requests and X-GitHub-Api-Version pins `refit github-api` lists per repository of a frozen list. A repository that could not be fetched or scanned has `error` and no findings.",
  "type": "object",
  "required": ["formatVersion", "list", "refit", "scannedAt", "results"],
  "properties": {
    "formatVersion": { "const": 1 },
    "list": { "type": "string" },
    "refit": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "$ref": "common.schema.json#/$defs/commit" },
        "dirty": { "type": "boolean" }
      }
    },
    "scannedAt": { "$ref": "common.schema.json#/$defs/time" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "commit"],
        "properties": {
          "repo": { "$ref": "common.schema.json#/$defs/repo" },
          "commit": { "$ref": "common.schema.json#/$defs/commit" },
          "packages": { "type": "array", "items": { "type": "string" } },
          "calls": { "type": "array", "items": { "$ref": "#/$defs/call" } },
          "pins": { "type": "array", "items": { "$ref": "#/$defs/pin" } },
          "error": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "call": {
      "type": "object",
      "$ref": "common.schema.json#/$defs/location",
      "required": ["kind", "use", "method", "route", "fields", "notices", "notes", "unknown"],
      "properties": {
        "kind": { "type": "string" },
        "use": { "type": "string" },
        "method": { "type": ["string", "null"] },
        "route": { "type": ["string", "null"] },
        "fields": { "type": "array" },
        "notices": { "type": "array" },
        "versionChanges": { "$ref": "common.schema.json#/$defs/count" },
        "notes": { "type": "array" },
        "unknown": { "type": "array" }
      }
    },
    "pin": {
      "type": "object",
      "$ref": "common.schema.json#/$defs/location",
      "required": ["use", "version"],
      "properties": {
        "use": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}
