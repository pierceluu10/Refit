{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Committed Shopify benchmark results",
  "description": "The condensed form of a Shopify run committed under docs/benchmarks: one row per repository with its outcome label. Copy the run's harness.json into `harness`.",
  "type": "object",
  "required": ["run", "refit", "rows", "harness"],
  "properties": {
    "run": { "$ref": "common.schema.json#/$defs/date" },
    "refit": { "$ref": "common.schema.json#/$defs/shortCommit" },
    "repeat": { "type": "string" },
    "harness": { "$ref": "harness.schema.json", "x-added": "2026-10-22" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "common.schema.json#/$defs/classified",
        "required": [
          "repo",
          "commit",
          "outcome",
          "sdk",
          "pins",
          "before",
          "target",
          "adminCalls",
          "documents",
          "tracedDocuments",
          "rest",
          "reason",
          "outcomeClass"
        ],
        "properties": {
          "repo": { "$ref": "common.schema.json#/$defs/repo" },
          "commit": { "$ref": "common.schema.json#/$defs/commit" },
          "outcome": {
            "enum": [
              "current",
              "current-for-sdk",
              "exceeds-scan-limits",
              "no-admin-usage",
              "patched-baseline-failed",
              "patched-no-checks",
              "patched-preparation-error",
              "patched-validated",
              "stopped-already-failing",
              "stopped-conflicting-pins",
              "stopped-dynamic-pin",
              "stopped-rest",
              "stopped-runtime-document",
              "stopped-sdk-upgrade",
              "stopped-unparseable-document"
            ]
          },
          "sdk": { "type": ["string", "null"] },
          "pins": { "type": ["array", "null"], "items": { "type": "string" } },
          "before": { "type": ["string", "null"] },
          "target": { "type": ["string", "null"] },
          "adminCalls": { "type": ["integer", "null"], "minimum": 0 },
          "documents": { "type": ["integer", "null"], "minimum": 0 },
          "tracedDocuments": { "type": ["integer", "null"], "minimum": 0 },
          "rest": { "type": ["integer", "null"], "minimum": 0 },
          "reason": { "type": ["string", "null"] },
          "seconds": { "$ref": "common.schema.json#/$defs/count" },
          "outcomeClass": {
            "$ref": "common.schema.json#/$defs/outcomeClass",
            "x-added": "2026-10-22"
          },
          "infrastructure": { "$ref": "common.schema.json#/$defs/infrastructure" }
        }
      }
    }
  }
}
