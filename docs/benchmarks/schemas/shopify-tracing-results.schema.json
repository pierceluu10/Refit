{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shopify document tracing before and after",
  "description": "Shopify outcomes, traced documents and unreadable documents per repository, each as [before, after] for two Refit commits.",
  "type": "object",
  "required": ["run", "refit", "sets"],
  "properties": {
    "run": { "$ref": "common.schema.json#/$defs/date" },
    "refit": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "common.schema.json#/$defs/shortCommit" },
        "after": { "$ref": "common.schema.json#/$defs/shortCommit" }
      }
    },
    "level": { "type": "string" },
    "schemas": { "type": "string" },
    "fields": { "type": "string" },
    "repeat": { "type": "string" },
    "sets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["repo", "commit", "outcome", "tracedDocuments", "unreadable"],
          "properties": {
            "repo": { "$ref": "common.schema.json#/$defs/repo" },
            "commit": { "$ref": "common.schema.json#/$defs/commit" },
            "outcome": { "$ref": "#/$defs/pair" },
            "tracedDocuments": { "$ref": "#/$defs/pair" },
            "unreadable": { "$ref": "#/$defs/pair" }
          }
        }
      }
    }
  },
  "$defs": {
    "pair": {
      "description": "[before, after]",
      "type": "array",
      "minItems": 2,
      "items": { "type": ["string", "integer", "null"] }
    }
  }
}
