{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zero-configuration enrollment results",
  "description": "Written from npm run benchmark:enrollment (pipeline/enrollment-benchmark-cli.ts): each repository through refit enroll and refit doctor with no hand edits, before (the proposed configuration committed, then each hand edit) and after (no .refit.json). Read-only: no repository code ran. See docs/overnight/P3.md.",
  "type": "object",
  "required": ["formatVersion", "description", "before", "after", "rows"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "description": { "type": "string" },
    "before": { "$ref": "#/$defs/run" },
    "after": { "$ref": "#/$defs/run" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "repo",
          "set",
          "packageManager",
          "listBefore",
          "before",
          "after",
          "fullDiffFalse"
        ],
        "additionalProperties": false,
        "properties": {
          "repo": { "$ref": "common.schema.json#/$defs/repo" },
          "set": { "type": "string", "minLength": 1 },
          "packageManager": { "$ref": "#/$defs/packageManager" },
          "listBefore": { "type": "string", "minLength": 1 },
          "before": {
            "description": "One step per hand edit, in order, or the reason the harness could not measure the repository.",
            "anyOf": [
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["edit", "enrolled", "status", "blocked"],
                  "additionalProperties": false,
                  "properties": {
                    "edit": { "enum": ["none", "contracts", "apiVersion"] },
                    "enrolled": { "type": "boolean" },
                    "status": { "$ref": "#/$defs/status" },
                    "blocked": { "$ref": "#/$defs/blocked" }
                  }
                }
              },
              {
                "type": "object",
                "required": ["crash"],
                "additionalProperties": false,
                "properties": { "crash": { "type": "string", "minLength": 1 } }
              }
            ]
          },
          "after": { "$ref": "#/$defs/after" },
          "fullDiffFalse": {
            "description": "A counterfactual doctor run of the generated configuration with fullDiff false; null without one.",
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["status", "blocked"],
                "additionalProperties": false,
                "properties": {
                  "status": { "$ref": "#/$defs/status" },
                  "blocked": { "$ref": "#/$defs/blocked" }
                }
              }
            ]
          }
        }
      }
    },
    "forks": {
      "type": "object",
      "required": ["description", "rows"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["repo", "commit", "packageManager", "listBefore", "after"],
            "additionalProperties": false,
            "properties": {
              "repo": { "$ref": "common.schema.json#/$defs/repo" },
              "commit": { "$ref": "common.schema.json#/$defs/commit" },
              "packageManager": { "$ref": "#/$defs/packageManager" },
              "listBefore": { "type": "string", "minLength": 1 },
              "after": { "$ref": "#/$defs/after" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["commit", "command"],
      "additionalProperties": false,
      "properties": {
        "commit": { "$ref": "common.schema.json#/$defs/shortCommit" },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "packageManager": { "enum": ["npm", "pnpm", "yarn", "none"] },
    "status": { "enum": ["ready-for-validation", "needs-attention"] },
    "blocked": {
      "description": "The ids of the doctor checks that block, in report order.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "after": {
      "type": "object",
      "required": ["enrolled", "status", "blocked", "crash", "apiVersion", "checks"],
      "additionalProperties": false,
      "properties": {
        "enrolled": { "type": "boolean" },
        "status": { "anyOf": [{ "$ref": "#/$defs/status" }, { "type": "null" }] },
        "blocked": { "$ref": "#/$defs/blocked" },
        "crash": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "apiVersion": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["value", "source"],
              "additionalProperties": false,
              "properties": {
                "value": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "checks": { "anyOf": [{ "enum": ["tests", "typecheck"] }, { "type": "null" }] }
      }
    }
  }
}
