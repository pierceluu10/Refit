{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only inventory sample",
  "description": "`node scripts/inventory-sample.mjs`: a read-only inventory of the first repositories of frozen lists, each at its recorded commit. The committed file adds `description`, `refitCommit` and `command`.",
  "type": "object",
  "required": ["takenAt", "limits", "results"],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "refitCommit": {
      "$ref": "common.schema.json#/$defs/commit"
    },
    "command": {
      "type": "string"
    },
    "takenAt": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "limits": {
      "$ref": "common.schema.json#/$defs/counts"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["list", "repo", "commit", "status"],
        "additionalProperties": false,
        "properties": {
          "list": {
            "type": "string"
          },
          "repo": {
            "$ref": "common.schema.json#/$defs/repo"
          },
          "commit": {
            "$ref": "common.schema.json#/$defs/commit"
          },
          "fetchMs": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "checkout": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": ["files", "bytes"],
                "properties": {
                  "files": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "bytes": {
                    "$ref": "common.schema.json#/$defs/count"
                  }
                }
              }
            ]
          },
          "scanMs": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "status": {
            "enum": ["complete", "stopped", "error"]
          },
          "stop": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "summary": {
            "description": "`inventorySummary` in pipeline/inventory.ts.",
            "type": "object",
            "required": [
              "providers",
              "deadlines",
              "mentions",
              "apiVersions",
              "models",
              "modelCalls"
            ],
            "properties": {
              "providers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deadlines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "date", "live"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "date": {
                      "$ref": "common.schema.json#/$defs/date"
                    },
                    "live": {
                      "$ref": "common.schema.json#/$defs/count"
                    }
                  }
                }
              },
              "mentions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "apiVersions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "modelCalls": {
                "$ref": "common.schema.json#/$defs/count"
              }
            }
          },
          "nonLiveModels": {
            "$ref": "common.schema.json#/$defs/count"
          }
        }
      }
    }
  }
}
