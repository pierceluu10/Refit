{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository inventory sample results",
  "description": "Written by scripts/inventory-sample.mjs: the read-only inventory summary (pipeline/inventory.ts inventorySummary) of each repository of the sampled frozen lists, with its checkout size and scan time. Summaries hold identifiers and counts only, never source lines.",
  "type": "object",
  "required": ["takenAt", "limits", "results"],
  "properties": {
    "description": {
      "type": "string"
    },
    "refitCommit": {
      "$ref": "common.schema.json#/$defs/commit"
    },
    "command": {
      "type": "string"
    },
    "takenAt": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "limits": {
      "type": "object"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["list", "repo", "commit", "status"],
        "properties": {
          "list": {
            "type": "string"
          },
          "repo": {
            "$ref": "common.schema.json#/$defs/repo"
          },
          "commit": {
            "$ref": "common.schema.json#/$defs/commit"
          },
          "fetchMs": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "checkout": {
            "type": "object"
          },
          "scanMs": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "status": {
            "type": "string"
          },
          "summary": {
            "type": "object"
          },
          "nonLiveModels": {
            "$ref": "common.schema.json#/$defs/count"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
