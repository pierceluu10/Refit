{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark harness record",
  "description": "What produced a benchmark run: the Refit commit and tree state, the frozen list's digest, the options, and the Node and Docker versions. Stripe and Shopify runs write it as harness.json beside results.json; the AI-app and deadline results files hold it under `harness`. See docs/BENCHMARK-HARNESS.md.",
  "type": "object",
  "required": [
    "formatVersion",
    "format",
    "refit",
    "list",
    "options",
    "node",
    "docker",
    "startedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "format": {
      "enum": ["stripe-results", "shopify-results", "ai-model-results", "deadline-results"]
    },
    "refit": {
      "type": "object",
      "required": ["commit", "source", "dirty", "allowDirty"],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "description": "null only when the source is unknown, which needs --allow-dirty.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/commit" }, { "type": "null" }]
        },
        "source": {
          "description": "git: read from the checkout. archive: a `git archive` export, whose commit is stamped into scripts/benchmark-commit.txt. unknown: neither.",
          "enum": ["git", "archive", "unknown"]
        },
        "dirty": {
          "description": "Tracked files that differ from the commit, and the SHA-256 of `git diff HEAD --binary`. Present only with --allow-dirty.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["files", "sha256"],
              "additionalProperties": false,
              "properties": {
                "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
              }
            }
          ]
        },
        "allowDirty": { "type": "boolean" }
      }
    },
    "list": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "The list as named on the command line, or selected.json in the Stripe root.",
          "type": "string",
          "minLength": 1
        },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "options": {
      "description": "The command-line options that can change outcomes, by name. Paths that only locate inputs and outputs are left out.",
      "type": "object"
    },
    "node": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+" },
    "docker": {
      "description": "null when the run does not use Docker.",
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/docker" }]
    },
    "startedAt": { "$ref": "common.schema.json#/$defs/time" },
    "resumes": {
      "description": "Each later --resume of the same run, with its own versions.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startedAt", "node", "docker"],
        "additionalProperties": false,
        "properties": {
          "startedAt": { "$ref": "common.schema.json#/$defs/time" },
          "node": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+" },
          "docker": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/docker" }] }
        }
      }
    }
  },
  "$defs": {
    "docker": {
      "type": "object",
      "required": ["version", "image", "imageId", "repoDigests"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "imageId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "repoDigests": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
