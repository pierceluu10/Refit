{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw HTTP API host inventory results",
  "description": "Written by scripts/api-hosts-benchmark.mjs: the external API hosts `refit api-hosts` lists per repository of the frozen sample, and the score against the blind labels. A repository that could not be scanned has `error` and no hosts.",
  "type": "object",
  "required": ["formatVersion", "refit", "dirty", "scannedAt", "score", "results"],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "refit": {
      "$ref": "common.schema.json#/$defs/commit"
    },
    "dirty": {
      "type": "boolean"
    },
    "scannedAt": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "score": {
      "type": "object",
      "required": [
        "repositories",
        "truePositives",
        "falsePositives",
        "falseNegatives",
        "precision",
        "recall"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "commit"],
        "properties": {
          "repo": {
            "$ref": "common.schema.json#/$defs/repo"
          },
          "commit": {
            "$ref": "common.schema.json#/$defs/commit"
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["host", "provider", "count"]
            }
          },
          "excluded": {
            "type": "object"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
