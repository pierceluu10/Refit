{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commerce API detection results",
  "description": "Written by scripts/commerce-benchmark.mjs: the providers `refit agents` detects and the registry entries `refit deadlines` reports and the API versions live code pins per repository of a frozen list, with scripts/commerce-score.mjs's score against the labels. A repository that could not be scanned has `error`.",
  "type": "object",
  "required": ["formatVersion", "list", "scannedAt", "repos"],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "list": {
      "type": "string"
    },
    "scannedAt": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "repo", "commit"],
        "properties": {
          "provider": {
            "type": "string"
          },
          "repo": {
            "$ref": "common.schema.json#/$defs/repo"
          },
          "commit": {
            "$ref": "common.schema.json#/$defs/commit"
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exposures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "object"
          },
          "seconds": {
            "type": "number"
          },
          "error": {
            "type": "string"
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "apiVersions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "score": {
      "type": "object"
    }
  }
}
