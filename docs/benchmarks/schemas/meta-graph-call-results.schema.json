{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta Graph API request detection results",
  "description": "Written by scripts/meta-graph-benchmark.mjs (Furqan's lanes own it): the Graph API requests `refit meta-graph` lists per repository.",
  "type": "object",
  "required": ["formatVersion", "scannedAt", "results"],
  "properties": {
    "formatVersion": { "const": 1 },
    "scannedAt": { "$ref": "common.schema.json#/$defs/date" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "commit", "sdk", "calls"],
        "properties": {
          "repo": { "$ref": "common.schema.json#/$defs/repo" },
          "commit": { "$ref": "common.schema.json#/$defs/commit" },
          "sdk": { "type": ["object", "null"] },
          "calls": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "common.schema.json#/$defs/location",
              "required": ["kind", "use", "versionSource", "unknown"],
              "properties": {
                "kind": { "type": "string" },
                "use": { "type": "string" },
                "version": { "type": ["string", "null"] },
                "versionSource": { "type": "string" },
                "unknown": { "type": "array" }
              }
            }
          }
        }
      }
    }
  }
}
