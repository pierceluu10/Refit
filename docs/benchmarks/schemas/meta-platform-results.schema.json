{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WhatsApp and Messenger request and version-move results",
  "description": "Written by scripts/meta-platform-benchmark.mjs: the Graph API requests `refit meta-graph` finds and the moves and stops `--propose-version-moves` reports per repository of a frozen list, with scripts/meta-platform-score.mjs's score against the labels. A repository that could not be scanned has `error`.",
  "type": "object",
  "required": ["formatVersion", "list", "target", "scannedAt", "repos"],
  "properties": {
    "formatVersion": { "const": 1 },
    "list": { "type": "string" },
    "target": { "type": "string" },
    "scannedAt": { "$ref": "common.schema.json#/$defs/time" },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "commit"],
        "properties": {
          "repo": { "$ref": "common.schema.json#/$defs/repo" },
          "commit": { "$ref": "common.schema.json#/$defs/commit" },
          "calls": { "type": "array", "items": { "type": "string" } },
          "guarded": { "type": "array", "items": { "type": "string" } },
          "moved": { "type": "array" },
          "stops": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pin", "reasons"],
              "properties": {
                "pin": { "type": "string" },
                "reasons": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "moves": { "type": "array" },
          "error": { "type": "string" }
        }
      }
    },
    "score": { "type": "object" }
  }
}
