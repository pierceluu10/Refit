{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI patch reliability scores",
  "description": "Written by `npm run eval:ai-patch` (pipeline/ai-patch-eval.ts): one labelled run per element, each with a summary and one outcome per case of docs/benchmarks/2026-10-22-ai-patch-cases.json.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["label", "summary", "results"],
    "properties": {
      "label": { "type": "string" },
      "summary": {
        "type": "object",
        "required": ["cases", "reached", "counts", "repairsRequested", "recordedCostUsd"],
        "properties": {
          "cases": { "type": "integer" },
          "reached": { "type": "integer" },
          "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
          "repairsRequested": { "type": "integer" },
          "recordedCostUsd": { "type": "number" }
        }
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "outcome"],
          "properties": {
            "id": { "type": "string" },
            "outcome": { "type": "string" },
            "validation": { "type": ["string", "null"] },
            "generator": { "type": ["string", "null"] },
            "aiAttempts": { "type": "integer" },
            "corrections": { "type": "integer" },
            "repairs": { "type": "integer" },
            "repairStop": { "type": ["string", "null"] },
            "costUsd": { "type": "number" },
            "costComplete": { "type": "boolean" },
            "detail": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
