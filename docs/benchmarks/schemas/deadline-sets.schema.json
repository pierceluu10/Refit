{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Committed deadline exposure counts per frozen set",
  "description": "Unlabelled `refit deadlines` exposures on other benchmarks' frozen sets, one row per repository, keyed by set. Copy the run's harness record into `harness`.",
  "type": "object",
  "required": ["run", "refit", "command", "sets", "harness"],
  "properties": {
    "run": { "$ref": "common.schema.json#/$defs/date" },
    "refit": { "$ref": "common.schema.json#/$defs/shortCommit" },
    "command": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "harness": { "$ref": "harness.schema.json", "x-added": "2026-10-22" },
    "sets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "$ref": "common.schema.json#/$defs/classified",
          "required": ["repo", "outcomeClass"],
          "anyOf": [{ "required": ["exposures"] }, { "required": ["error"] }],
          "properties": {
            "repo": { "$ref": "common.schema.json#/$defs/repo" },
            "exposures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "days"],
                "additionalProperties": false,
                "properties": { "id": { "type": "string" }, "days": { "type": "integer" } }
              }
            },
            "error": { "type": "string", "minLength": 1 },
            "outcomeClass": {
              "$ref": "common.schema.json#/$defs/outcomeClass",
              "x-added": "2026-10-22"
            },
            "infrastructure": { "$ref": "common.schema.json#/$defs/infrastructure" }
          }
        }
      }
    }
  }
}
