{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta Graph API version move proposals",
  "description": "`refit meta-graph --propose-version-moves` per repository with the committed, empty (hypothetical) and reviewed change lists.",
  "type": "object",
  "required": ["formatVersion", "ranAt", "target", "results"],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "ranAt": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "target": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$"
    },
    "note": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "committed", "hypothetical", "reviewed"],
        "properties": {
          "repo": {
            "$ref": "common.schema.json#/$defs/repo"
          },
          "committed": {
            "$ref": "#/$defs/proposal"
          },
          "hypothetical": {
            "$ref": "#/$defs/proposal"
          },
          "reviewed": {
            "$ref": "#/$defs/proposal"
          }
        }
      }
    }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "required": ["moves", "stops"],
      "properties": {
        "moves": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/location"
          }
        },
        "stops": {
          "type": "array",
          "items": {
            "description": "A stop has no pin location when the request names no version; the reason names the request instead.",
            "type": "object",
            "required": ["file", "line", "requests", "reasons"],
            "properties": {
              "file": {
                "type": ["string", "null"]
              },
              "line": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "requests": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
