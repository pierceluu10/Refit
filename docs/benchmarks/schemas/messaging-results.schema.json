{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Messaging API detection results",
  "description": "Written by scripts/messaging-benchmark.mjs: the providers, SDK declarations and deprecated calls `refit messaging` lists per repository of a frozen list, with scripts/messaging-score.mjs's score against the labels. `refit` was recorded by hand for these runs. A repository that could not be scanned has `error`.",
  "type": "object",
  "required": ["formatVersion", "list", "checkedAt", "summary", "results"],
  "properties": {
    "formatVersion": { "const": 1 },
    "list": { "type": "string" },
    "checkedAt": { "$ref": "common.schema.json#/$defs/time" },
    "summary": { "type": "object" },
    "score": { "type": "object" },
    "refit": {
      "type": "object",
      "required": ["commit"],
      "properties": {
        "commit": { "$ref": "common.schema.json#/$defs/shortCommit" },
        "note": { "type": "string" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "commit", "status"],
        "properties": {
          "repo": { "$ref": "common.schema.json#/$defs/repo" },
          "commit": { "$ref": "common.schema.json#/$defs/commit" },
          "group": { "type": "string" },
          "declared": { "type": "object" },
          "status": { "type": "string" },
          "providers": { "type": "array", "items": { "type": "object" } },
          "packages": { "type": "array", "items": { "type": "object" } },
          "calls": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "common.schema.json#/$defs/location",
              "required": ["provider", "kind", "use", "member"],
              "properties": {
                "provider": { "type": "string" },
                "kind": { "type": "string" },
                "use": { "type": "string" },
                "member": { "type": "string" },
                "call": { "type": "string" },
                "message": { "type": "string" },
                "replacement": { "type": "string" },
                "source": { "type": "string" },
                "date": { "type": ["string", "null"] },
                "text": { "type": "string" }
              }
            }
          },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "error": { "type": "string" }
        }
      }
    }
  }
}
