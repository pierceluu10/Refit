{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shopify benchmark run results",
  "description": "results.json written by `npm run benchmark:shopify`: one row per repository, in list order. Its harness.json follows harness.schema.json.",
  "type": "array",
  "items": {
    "type": "object",
    "$ref": "common.schema.json#/$defs/classified",
    "required": ["repo", "commit", "outcomeClass"],
    "properties": {
      "repo": { "$ref": "common.schema.json#/$defs/repo" },
      "stars": { "$ref": "common.schema.json#/$defs/count" },
      "commit": { "$ref": "common.schema.json#/$defs/commit" },
      "read": { "description": "Why Refit could not read the repository.", "type": "string" },
      "packageName": { "type": "string" },
      "sdk": { "type": ["string", "null"] },
      "adminCalls": { "$ref": "common.schema.json#/$defs/count" },
      "documents": { "$ref": "common.schema.json#/$defs/count" },
      "tracedDocuments": { "$ref": "common.schema.json#/$defs/count" },
      "unreadable": { "$ref": "common.schema.json#/$defs/count" },
      "rest": { "$ref": "common.schema.json#/$defs/count" },
      "restCalls": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/location" } },
      "pins": { "type": "array", "items": { "type": "string" } },
      "pinKinds": { "type": "array", "items": { "type": "string" } },
      "unresolvedPins": { "$ref": "common.schema.json#/$defs/count" },
      "before": { "type": "string" },
      "after": { "type": ["string", "null"] },
      "target": { "type": "string" },
      "latestNeedsSdkUpgrade": { "type": "boolean" },
      "outcome": {
        "enum": [
          "no-admin-usage",
          "current",
          "current-for-sdk",
          "stopped",
          "unpatched",
          "patched",
          "error"
        ]
      },
      "result": {
        "description": "The gut plan's four outcomes (docs/GUT-PLAN.md): validated, needs-review, no-change or infrastructure.",
        "enum": ["validated", "needs-review", "no-change", "infrastructure"]
      },
      "onNewestReachable": { "type": "boolean" },
      "error": { "type": "string" },
      "scan": {
        "type": "object",
        "required": ["status", "patch", "findings"],
        "properties": {
          "status": { "type": "string" },
          "patch": { "type": "string" },
          "findings": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/location" } }
        }
      },
      "checks": { "enum": ["none", "tests", "typecheck"] },
      "workflow": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "seconds": { "$ref": "common.schema.json#/$defs/count" },
      "outcomeClass": { "$ref": "common.schema.json#/$defs/outcomeClass", "x-added": "2026-10-22" },
      "infrastructure": { "$ref": "common.schema.json#/$defs/infrastructure" }
    }
  }
}
