{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemini detection benchmark results",
  "description": "Written by scripts/gemini-benchmark.mjs (Furqan's lanes own it): the old-SDK exposure the shipped scan reports, and a census of Gemini model IDs by use.",
  "type": "object",
  "required": ["formatVersion", "list", "provider", "ranAt", "summary", "results"],
  "properties": {
    "formatVersion": { "const": 1 },
    "list": { "type": "string" },
    "provider": { "const": "gemini" },
    "ranAt": { "$ref": "common.schema.json#/$defs/time" },
    "note": { "type": "string" },
    "summary": { "type": "object" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "commit", "sdk"],
        "anyOf": [
          {
            "required": [
              "shippedExposures",
              "geminiIds",
              "uses",
              "capped",
              "liveInSdkFiles",
              "live"
            ]
          },
          { "required": ["error"] }
        ],
        "properties": {
          "repo": { "$ref": "common.schema.json#/$defs/repo" },
          "commit": { "$ref": "common.schema.json#/$defs/commit" },
          "sdk": { "type": "string" },
          "shippedExposures": { "type": "array", "items": { "type": "object" } },
          "geminiIds": { "$ref": "common.schema.json#/$defs/count" },
          "uses": { "$ref": "common.schema.json#/$defs/counts" },
          "capped": { "$ref": "common.schema.json#/$defs/count" },
          "liveInSdkFiles": { "$ref": "common.schema.json#/$defs/count" },
          "live": { "type": "array", "items": { "type": "string" } },
          "error": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
