    {
      "rule": "openai-node-target-6",
      "family": "package-target",
      "status": "auto",
      "page": "openai-node-6.0.0",
      "quote": "### ⚠ BREAKING CHANGES",
      "checkedAt": "2026-10-29",
      "origin": "docs",
      "summary": "Moves the openai package to the newest 6.x release. 6.x has no runtime dependencies; 7.0.0 only adds a Node.js 22 requirement, which Refit does not impose on a repository.",
      "data": {
        "package": "openai",
        "targetMajor": 6,
        "applyBelowMajor": 6,
        "oldestMajor": 3,
        "surface": "data/sdk-surfaces/openai-6.json"
      }
    },
    {
      "rule": "openai-node-v4-client",
      "family": "client-constructor",
      "status": "auto",
      "page": "openai-node-v4",
      "quote": "const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY // This is also the default, can be omitted });",
      "checkedAt": "2026-10-29",
      "origin": "docs",
      "summary": "Replaces `new OpenAIApi(new Configuration({ apiKey, organization, basePath }))` with `new OpenAI({ apiKey, organization, baseURL })`.",
      "data": {
        "fromMajor": 3,
        "oldClasses": [
          "Configuration",
          "OpenAIApi"
        ],
        "newClass": "OpenAI",
        "options": {
          "apiKey": "apiKey",
          "organization": "organization",
          "basePath": "baseURL"
        }
      }
    },
