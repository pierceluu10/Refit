      "rule": "shopify-rest-post-products-id-images",
      "family": "rest-to-graphql",
      "method": "POST",
      "path": "products/{product_id}/images.json",
      "replacement": "Mutation.productCreateMedia",
      "source": "https://shopify.dev/docs/api/admin-rest/latest/resources/product-image",
      "warning": "Flags POST products/{product_id}/images.json, a deprecated REST product image endpoint, and names productCreateMedia, the GraphQL field Shopify's REST reference lists for it. Request and response shapes differ, so the call is not rewritten.",
      "quote": "[/admin/api/latest/products/{product\\_​id}/images.​json](https://shopify.dev/docs/api/admin-rest/latest/resources/product-image.md#post-products-product-id-images)\n\nCreate a new Product Image\n\n[productCreateMedia](https://shopify.dev/docs/api/admin-graphql/latest/mutations/productCreateMedia?example=create-a-new-product-image)",
      "checkedAt": "2026-10-29",
      "status": "review-only",
      "origin": "hand-written",
      "diff": {
        "id": "graphql-replacement-present",
        "operationId": "Mutation.productCreateMedia",
        "text": "POST products/{product_id}/images.json is answered by Mutation.productCreateMedia."
      }
    },
