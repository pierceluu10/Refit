      {
        "note": "From Gemini 3.6 Flash and 3.5 Flash-Lite on, temperature, top_p and top_k are deprecated and ignored, and future generations return a 400 for them. Remove them.",
        "url": "https://ai.google.dev/gemini-api/docs/whats-new-gemini-3.6#api-changes-and-parameter-updates"
      },
      {
        "note": "A request whose last non-empty turn is a model turn returns a 400. Use system_instruction or structured outputs in place of prefill.",
        "url": "https://ai.google.dev/gemini-api/docs/whats-new-gemini-3.6#api-changes-and-parameter-updates"
      },
      {
        "note": "candidate_count is unsupported in Gemini 3 and later.",
        "url": "https://ai.google.dev/gemini-api/docs/whats-new-gemini-3.8#migrate-to-gemini-3-8-flash"
      },
      {
        "note": "Replace thinking_budget with thinking_level. gemini-3.8-flash takes low, medium (default) or high; minimal returns an error.",
        "url": "https://ai.google.dev/gemini-api/docs/whats-new-gemini-3.8#understanding-reasoning-levels"
      },
      {
        "note": "gemini-3.5-flash-lite defaults thinking_level to minimal; the guide suggests medium or high for subagents with tool calls, code execution or multi-step reasoning.",
        "url": "https://ai.google.dev/gemini-api/docs/whats-new-gemini-3.6#migrate-to-gemini-3-5-flash-lite"
      },
      {
        "note": "On the generateContent API, all FunctionResponse objects need call_id and name. Place multimodal assets inside the response payload; thought signatures must be preserved.",
        "url": "https://ai.google.dev/gemini-api/docs/whats-new-gemini-3.8#migrate-to-gemini-3-8-flash"
      }
    ]
