  "packages": {
    "next": [
      {
        "command": "npx @next/codemod upgrade major",
        "applies": "moves to the next major and runs the codemods for it; also takes patch, minor, a version such as 16, or a tag",
        "url": "https://nextjs.org/docs/app/guides/upgrading/codemods",
        "official": true
      },
      {
        "command": "npx @next/codemod <transform> <path>",
        "applies": "one named transform; the linked page lists them per version",
        "url": "https://nextjs.org/docs/app/guides/upgrading/codemods",
        "official": true
      }
    ],
    "react": [
      {
        "command": "npx codemod@latest react/19/migration-recipe",
        "applies": "React 18 to 19",
        "url": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide",
        "official": true
      },
      {
        "command": "npx types-react-codemod@latest preset-19 ./path-to-app",
        "applies": "@types/react changes for React 19",
        "url": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide",
        "official": true
      }
    ],
    "express": [
      {
