      "fields": [
        { "rest": "id", "graphql": "MediaImage.id" },
        { "rest": "src", "graphql": "MediaImage.image.url" },
        { "rest": "width / height", "graphql": "MediaImage.image.width / height" },
        { "rest": "position", "graphql": "order of product.media; productReorderMedia" },
        { "rest": "variant_ids", "graphql": "productVariantAppendMedia / ProductVariant.media" }
      ],
      "notes": [
        "In the 2026-10 schema productCreateMedia, productUpdateMedia and productDeleteMedia are deprecated in favour of productUpdate / productSet (media) and fileUpdate. Validate with shopify_validate_graphql."
      ],
      "source": "https://shopify.dev/docs/api/admin-rest/latest/resources/product-image"
