{
  "source": [
    "https://shopify.dev/docs/api/admin-rest",
    "https://shopify.dev/docs/api/usage/gids",
    "https://shopify.dev/docs/apps/build/product-merchandising/products-and-collections"
  ],
  "retrieved": "2026-11-01",
  "note": "GraphQL equivalents are the ones each REST reference page lists per endpoint. Paths are written as on shopify.dev with {placeholders}; the tool normalizes versions, ids and .json.",
  "general": [
    {
      "text": "The REST Admin API is legacy as of October 1, 2024; from April 1, 2025 new public apps must be built only with the GraphQL Admin API. Some newer features exist only in GraphQL.",
      "source": "https://shopify.dev/docs/api/admin-rest"
    },
    {
      "text": "IDs are global IDs: gid://shopify/{object_name}/{id}, e.g. gid://shopify/Product/123. Most REST responses include admin_graphql_api_id with the GID. Some child objects use parameterized IDs, e.g. gid://shopify/InventoryLevel/123?inventory_item_id=456.",
      "source": "https://shopify.dev/docs/api/usage/gids"
    },
    {
      "text": "All GraphQL calls are POST /admin/api/{version}/graphql.json with the X-Shopify-Access-Token header. Errors can come back with HTTP 200: read the top-level errors array, and request userErrors on every mutation.",
      "source": "https://shopify.dev/docs/api/admin-graphql"
    },
    {
      "text": "Lists are connections with cursor pagination (first/after, last/before, pageInfo { hasNextPage endCursor }), up to 250 nodes per page, instead of REST Link headers. Use bulk operations for large exports.",
      "source": "https://shopify.dev/docs/api/usage/pagination-graphql"
    },
    {
      "text": "Rate limits are calculated query cost (points per second by plan; a single query may cost at most 1,000 points) instead of the REST request bucket. Check extensions.cost.throttleStatus.",
      "source": "https://shopify.dev/docs/apps/build/apis/graphql-admin/rate-limits"
    },
    {
      "text": "Field names are camelCase (body_html -> descriptionHtml, created_at -> createdAt). Money is usually a MoneyBag (*Set fields with shopMoney and presentmentMoney) rather than a bare string; the bare-money fields are deprecated.",
      "source": "https://shopify.dev/docs/api/admin-graphql"
    }
  ],
  "resources": [
    {
      "resource": "product",
      "aliases": ["products"],
      "graphqlType": "Product",
      "docs": "https://shopify.dev/docs/api/admin-rest/latest/resources/product",
      "deprecation": "Listing, creating, updating and deleting products through REST is deprecated as of REST API 2024-04 (new product model). REST can't read or write products with more than 100 variants; GraphQL supports up to 2,048.",
      "endpoints": [
        { "method": "POST", "path": "/products.json", "graphql": ["productCreate", "productSet"] },
        { "method": "GET", "path": "/products.json", "graphql": ["products"] },
        { "method": "GET", "path": "/products/{product_id}.json", "graphql": ["product"] },
        { "method": "GET", "path": "/products/count.json", "graphql": ["productsCount"] },
        {
          "method": "PUT",
          "path": "/products/{product_id}.json",
          "graphql": ["productUpdate", "productSet"]
        },
        { "method": "DELETE", "path": "/products/{product_id}.json", "graphql": ["productDelete"] }
      ],
      "fields": [
        { "rest": "body_html", "graphql": "descriptionHtml" },
        {
          "rest": "images",
          "graphql": "media",
          "note": "Images are Media (MediaImage). Product.images is deprecated in GraphQL; upload with fileCreate or staged uploads and attach via productCreate/productUpdate/productSet media."
        },
        {
          "rest": "image",
          "graphql": "featuredMedia",
          "note": "Product.featuredImage is deprecated; use featuredMedia."
        },
        {
          "rest": "variants",
          "graphql": "variants (connection)",
          "note": "Variants are written with productVariantsBulkCreate / productVariantsBulkUpdate / productVariantsBulkDelete, or productSet. productCreate/productUpdate no longer take a variants list."
        },
        {
          "rest": "options",
          "graphql": "options",
          "note": "Options are ProductOption with optionValues; edit with productOptionsCreate, productOptionUpdate, productOptionsReorder, productOptionsDelete."
        },
        {
          "rest": "published_scope",
          "graphql": "publishedOnPublication",
          "note": "Publishing is per publication (publishablePublish / publishableUnpublish)."
        },
        { "rest": "product_type", "graphql": "productType" },
        { "rest": "published_at", "graphql": "publishedAt" },
        { "rest": "template_suffix", "graphql": "templateSuffix" },
        {
          "rest": "tags",
          "graphql": "tags",
          "note": "A list of strings rather than a comma-separated string."
        },
        { "rest": "status", "graphql": "status", "note": "Enum ACTIVE / ARCHIVED / DRAFT." }
      ],
      "notes": [
        "productSet replaces list fields such as options and variants with what you send, and leaves other fields alone; it's meant for syncing from an external source of truth and supports async mode.",
        "Product webhooks send full variant data only for the first 100 variants."
      ],
      "source": "https://shopify.dev/docs/api/admin-rest/latest/resources/product"
    },
    {
      "resource": "product_variant",
      "aliases": ["variant", "variants", "product variant"],
      "graphqlType": "ProductVariant",
      "docs": "https://shopify.dev/docs/api/admin-rest/latest/resources/product-variant",
      "deprecation": "Listing, creating, updating and deleting product variants through REST is deprecated as of REST API 2024-04. Apps can no longer set inventory with inventory_quantity.",
      "endpoints": [
        {
          "method": "POST",
          "path": "/products/{product_id}/variants.json",
          "graphql": ["productVariantsBulkCreate", "productCreate"]
        },
        {
          "method": "GET",
          "path": "/products/{product_id}/variants.json",
          "graphql": ["productVariants", "product { variants }"]
        },
        {
          "method": "GET",
          "path": "/products/{product_id}/variants/count.json",
          "graphql": ["productVariantsCount"]
        },
        { "method": "GET", "path": "/variants/{variant_id}.json", "graphql": ["productVariant"] },
        {
          "method": "PUT",
          "path": "/variants/{variant_id}.json",
          "graphql": ["productVariantsBulkUpdate"]
        },
        {
          "method": "DELETE",
          "path": "/products/{product_id}/variants/{variant_id}.json",
          "graphql": ["productVariantsBulkDelete"]
        }
      ],
      "fields": [
        {
          "rest": "inventory_quantity",
          "graphql": "inventoryQuantity (read-only)",
          "note": "Read-only total across locations. Set stock per location with inventorySetQuantities / inventoryAdjustQuantities on InventoryLevel."
        },
        { "rest": "inventory_item_id", "graphql": "inventoryItem { id }" },
        {
          "rest": "inventory_management",
          "graphql": "inventoryItem.tracked",
          "note": "The REST page maps this to the InventoryItem; in GraphQL tracking is InventoryItem.tracked (ProductVariant.inventoryManagement no longer exists in 2026-10)."
        },
        { "rest": "sku", "graphql": "sku (also InventoryItem.sku)" },
        {
          "rest": "weight / weight_unit / grams",
          "graphql": "inventoryItem.measurement.weight",
          "note": "ProductVariant has no weight field in 2026-10; weight lives on InventoryItem.measurement. grams is deprecated in REST."
        },
        {
          "rest": "fulfillment_service",
          "graphql": "Location.fulfillmentService",
          "note": "Variants are stocked at fulfillment service locations instead."
        },
        {
          "rest": "image_id",
          "graphql": "media",
          "note": "ProductVariant.image is deprecated; attach media with productVariantAppendMedia / productVariantDetachMedia."
        },
        {
          "rest": "option1 / option2 / option3",
          "graphql": "selectedOptions { name value }",
          "note": "In bulk mutations pass optionValues [{ optionName, name }]."
        }
      ],
      "notes": [
        "productVariantsBulkCreate/Update handle up to 2,048 variants per call; productVariantsBulkDelete up to 250."
      ],
      "source": "https://shopify.dev/docs/api/admin-rest/latest/resources/product-variant"
    },
    {
      "resource": "product_image",
