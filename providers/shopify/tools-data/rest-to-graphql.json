      "docs": "https://shopify.dev/docs/api/admin-rest/latest/resources/product-image",
      "deprecation": "Listing, creating, updating and deleting product images through REST is deprecated as of REST API 2025-01.",
      "endpoints": [
        {
          "method": "POST",
          "path": "/products/{product_id}/images.json",
          "graphql": ["productCreateMedia", "productUpdate (media)", "fileCreate"]
