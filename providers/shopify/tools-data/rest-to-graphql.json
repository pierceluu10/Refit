        {
          "method": "GET",
          "path": "/products/{product_id}/images/count.json",
          "graphql": ["product { mediaCount }"]
        },
        {
          "method": "PUT",
          "path": "/products/{product_id}/images/{image_id}.json",
          "graphql": ["productUpdateMedia", "fileUpdate"]
        },
        {
          "method": "DELETE",
