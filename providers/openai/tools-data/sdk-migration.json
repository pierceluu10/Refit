    "source": "GitHub releases of openai/openai-python and openai/openai-node, checked 2026-11-01"
  },
  "majors": [
    {
      "sdk": "openai-python",
      "version": "1.0.0",
      "date": "2023-11-06",
      "summary": "Total rewrite: explicit client (from openai import OpenAI; client = OpenAI()), pydantic response objects (no dict access; use .model_dump()), AsyncOpenAI instead of a* methods, httpx instead of requests, auto-paginating list(). Automatic migration: `openai migrate` (grit).",
      "source": "https://github.com/openai/openai-python/discussions/742"
    },
    {
      "sdk": "openai-python",
      "version": "2.0.0",
      "date": "2025-09-30",
      "summary": "Breaking: ResponseFunctionToolCallOutputItem.output and ResponseCustomToolCallOutput.output can now be a string or an array of input text/image/file parts, not only a string.",
      "source": "https://github.com/openai/openai-python/blob/main/CHANGELOG.md"
    },
    {
      "sdk": "openai-python",
      "version": "3.0.0",
      "date": "2026-08-12",
      "summary": "Breaking: HTTPX2 is the default HTTP client and httpx is no longer installed automatically. Custom httpx clients, transports or config objects (e.g. http_client=httpx.Client(...), DefaultHttpxClient) must move to HTTPX2 equivalents or use the temporary legacy escape hatch. See httpx2.md in the repo.",
      "source": "https://github.com/openai/openai-python/releases/tag/v3.0.0"
    },
    {
      "sdk": "openai-node",
      "version": "4.0.0",
      "date": "2023-08-16",
      "summary": "Total rewrite: `import OpenAI from 'openai'; new OpenAI({apiKey})` replaces Configuration/OpenAIApi; results are returned directly (no `.data`); errors are OpenAI.APIError; headers via .withResponse(). Automatic migration: `npm exec openai migrate` (grit).",
      "source": "https://github.com/openai/openai-node/discussions/217"
    },
    {
      "sdk": "openai-node",
      "version": "5.0.0",
      "date": "2025-05-29",
      "summary": "Moved from node-fetch to the built-in fetch, zero dependencies. Breaking: Web types for withResponse/asResponse and APIError.headers (a Headers instance), named path params for multi-param methods (e.g. vectorStores.files.retrieve(fileId, {vector_store_id})), httpAgent removed in favor of fetchOptions, beta.chat namespace removed, runFunctions removed, del() methods renamed to delete(), openai/src removed, export reshuffles.",
      "source": "https://github.com/openai/openai-node/blob/main/MIGRATION.md"
    },
    {
      "sdk": "openai-node",
      "version": "6.0.0",
      "date": "2025-09-30",
      "summary": "Breaking: function/custom tool call output items' `output` can be a string or an array of input text/image/file parts.",
      "source": "https://github.com/openai/openai-node/blob/main/CHANGELOG.md"
    },
    {
      "sdk": "openai-node",
      "version": "7.0.0",
      "date": "2026-07-27",
      "summary": "Breaking: requires Node.js 22 (MIGRATION.md now lists Node.js 22 LTS, TypeScript 4.9, Jest 28 as minimums).",
      "source": "https://github.com/openai/openai-node/blob/main/CHANGELOG.md"
    }
  ],
